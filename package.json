{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "node tools/patch-markdown-renderer.cjs",
    "prebuild": "node tools/patch-markdown-renderer.cjs && node tools/test-markdown-renderer.cjs",
    "build": "hexo clean && hexo generate",
    "check": "npm run validate:content && npm run build",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "validate:content": "node tools/validate-content.mjs",
    "validate:reading": "node tools/test-reading-dates.mjs && node tools/validate-reading.mjs",
    "validate:discovery": "node tools/test-discovery.mjs && node tools/validate-discovery.mjs",
    "validate:links": "node tools/test-links.cjs && node tools/validate-links.cjs",
    "validate:quality": "node tools/test-responsive-media.cjs && node tools/validate-quality.cjs",
    "report:external-links": "node tools/report-external-links.cjs",
    "media:generate": "node tools/generate-responsive-media.cjs"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "@traptitech/markdown-it-katex": "^3.6.0",
    "hexo": "^8.1.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-excerpt": "^1.1.6",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.3.3",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-markdown-it": "^7.1.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0"
  },
  "devDependencies": {
    "hexo-generator-feed": "^4.0.0",
    "htmlparser2": "6.1.0",
    "js-yaml": "5.4.1",
    "sharp": "0.35.4"
  },
  "overrides": {
    "hexo-server": {
      "morgan": "1.12.0"
    },
    "hexo-renderer-markdown-it": {
      "markdown-it": "15.0.0",
      "linkify-it": "6.1.0"
    },
    "cross-spawn": ">=7.0.6",
    "picomatch": ">=4.0.3",
    "minimatch": ">=3.1.5",
    "brace-expansion": ">=2.0.2",
    "prismjs": ">=1.30.0",
    "katex": ">=0.16.21",
    "on-headers": ">=1.1.0",
    "send": ">=0.19.0",
    "serve-static": ">=1.16.2"
  }
}
