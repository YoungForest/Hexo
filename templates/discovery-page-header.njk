{# NeXT v8.27.0 page header; the annual overview has no /series/ parent. #}
<header class="post-header">
<h1 class="post-title" itemprop="name headline">
  {{- page.title }}
  {{- post_edit(page.source) }}
</h1>
<div class="post-meta-container">
  {%- if page.description %}
    <div class="post-description">{{ page.description }}</div>
  {%- endif %}
  {%- if page.discovery !== 'series' %}{% include '_partials/page/breadcrumb.njk' %}{% endif -%}
</div>
</header>
