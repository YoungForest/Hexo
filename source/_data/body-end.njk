<script>
  (() => {
    if (window.location.hostname !== 'youngforest.github.io') return;
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function() { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', 'G-G6NR9DW560');
    const loadAnalytics = () => {
      if (document.querySelector('script[data-ga4-loader]')) return;
      const script = document.createElement('script');
      script.async = true;
      script.dataset.ga4Loader = '';
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-G6NR9DW560';
      document.head.appendChild(script);
    };
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(loadAnalytics, { timeout: 2500 });
    } else {
      window.addEventListener('load', () => window.setTimeout(loadAnalytics, 1000), { once: true });
    }
  })();
</script>
{% if page.layout == 'post' %}
<script>
  (() => {
    const reported = new Set();
    const thresholds = [25, 50, 75, 100];
    const reportDepth = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollable <= 0) return;
      const depth = Math.min(100, Math.round((window.scrollY / scrollable) * 100));
      thresholds.forEach(percent => {
        if (depth >= percent && !reported.has(percent)) {
          reported.add(percent);
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'scroll_depth', {
              percent_scrolled: percent,
              page_path: window.location.pathname
            });
          }
        }
      });
    };
    window.addEventListener('scroll', reportDepth, { passive: true });
    reportDepth();
  })();
</script>
{% endif %}
<script>
  (() => {
    const sidebarToggle = document.querySelector('.sidebar-toggle[role="button"]');
    if (sidebarToggle && !sidebarToggle.hasAttribute('aria-label')) {
      sidebarToggle.setAttribute('aria-label', '切换侧栏');
    }
  })();
</script>
