.post-body .review-cover {
  margin: 1.25rem auto;
  text-align: center;
}

.post-body .review-cover img {
  display: block;
  width: 200px;
  max-width: 100%;
  height: auto;
  margin: 0 auto;
  padding: 0;
  border: 0;
}

.post-body figure.review-cover:not(.highlight) figcaption {
  max-width: 32rem;
  margin: .65rem auto 0 !important;
  color: #666;
  font-size: 12px;
  font-weight: normal;
  line-height: 1.65;
}

.index .post-body .review-cover img {
  width: 160px;
}

.editorial-illustration {
  margin: 1.75rem auto;
}

.editorial-illustration--hero {
  margin-top: .75rem;
}

.editorial-illustration img {
  aspect-ratio: 16 / 9;
  display: block;
  height: auto;
  max-width: 100%;
  width: 100%;
}

.post-hero img {
  aspect-ratio: 16 / 9;
  display: block;
  height: auto;
  max-width: 100%;
  width: 100%;
}

@media (max-width: 390px) {
  .editorial-illustration {
    margin: 1.25rem auto;
  }
}

.post-meta,
.post-description
  color: #666

.followme span
  color: #666

.post-body .legacy-comments {
  border-top: 1px solid #d8dee4;
  margin: 3rem 0 1.5rem;
  padding-top: 1.6rem;
  text-align: left;
}

.legacy-comments__header {
  align-items: center;
  display: flex;
  gap: .75rem;
  justify-content: space-between;
}

.legacy-comments__title {
  align-items: center;
  border: 0;
  display: flex;
  font-size: 1.3rem;
  gap: .55rem;
  margin: 0;
  padding: 0;
}

.legacy-comments__count {
  align-items: center;
  background: #eff2f5;
  border-radius: 999px;
  color: #57606a;
  display: inline-flex;
  font-size: .72em;
  font-weight: 600;
  height: 1.65rem;
  justify-content: center;
  min-width: 1.65rem;
  padding: 0 .45rem;
}

.legacy-comments__badge {
  background: #f6f8fa;
  border: 1px solid #d0d7de;
  border-radius: 999px;
  color: #57606a;
  flex: 0 0 auto;
  font-size: .72rem;
  font-weight: 600;
  letter-spacing: .02em;
  line-height: 1.8;
  padding: 0 .65rem;
}

.legacy-comments__note {
  color: #656d76;
  font-size: .86rem;
  line-height: 1.6;
  margin: .45rem 0 1.5rem;
}

.legacy-comments__list,
.legacy-comment__replies {
  list-style: none;
  margin: 0;
  padding: 0;
}

.legacy-comments__list > .legacy-comment-item {
  padding: 0 0 1.35rem;
}

.legacy-comments__list > .legacy-comment-item + .legacy-comment-item {
  border-top: 1px solid #eaeef2;
  padding-top: 1.35rem;
}

.legacy-comment {
  align-items: start;
  display: grid;
  gap: .75rem;
  grid-template-columns: 2rem minmax(0, 1fr);
  overflow-wrap: anywhere;
}

.legacy-comment__avatar {
  align-items: center;
  border: 1px solid rgba(31, 35, 40, .08);
  border-radius: 50%;
  display: inline-flex;
  font-size: .78rem;
  font-weight: 650;
  height: 2rem;
  justify-content: center;
  line-height: 1;
  text-transform: uppercase;
  width: 2rem;
}

.legacy-comment__avatar--0 { background: #e7f3f1; color: #1d746f; }
.legacy-comment__avatar--1 { background: #f6efe1; color: #8a6500; }
.legacy-comment__avatar--2 { background: #edf1f5; color: #57606a; }
.legacy-comment__avatar--3 { background: #f1edfa; color: #6f42c1; }
.legacy-comment__avatar--4 { background: #eaf2ff; color: #0969da; }
.legacy-comment__avatar--5 { background: #f8eeee; color: #b4232e; }

.legacy-comment__content {
  min-width: 0;
}

.legacy-comment__meta {
  align-items: baseline;
  display: flex;
  flex-wrap: wrap;
  gap: .25rem .65rem;
  justify-content: flex-start;
  min-height: 2rem;
  text-align: left;
}

.legacy-comment__author {
  border: 0;
  color: #24292f;
  font-size: .94rem;
  font-weight: 650;
  line-height: 1.5;
  margin: 0;
  padding: 0;
}

.legacy-comment__meta time {
  color: #6e7781;
  font-size: .76rem;
  white-space: nowrap;
}

.legacy-comment__body {
  color: #34383d;
  font-size: .94rem;
  line-height: 1.75;
  margin-top: .15rem;
  text-align: left;
}

.legacy-comment__replies {
  border-left: 1px solid #d8dee4;
  margin: 1rem 0 0 1rem;
  padding-left: 1rem;
}

.legacy-comment__replies > .legacy-comment-item + .legacy-comment-item {
  margin-top: 1rem;
}

@media (max-width: 390px) {
  .legacy-comments {
    margin-top: 2.25rem;
    padding-top: 1.25rem;
  }

  .legacy-comments__header {
    align-items: flex-start;
  }

  .legacy-comments__title {
    font-size: 1.18rem;
  }

  .legacy-comments__note {
    margin-bottom: 1.25rem;
  }

  .legacy-comment {
    gap: .6rem;
    grid-template-columns: 1.75rem minmax(0, 1fr);
  }

  .legacy-comment__avatar {
    font-size: .7rem;
    height: 1.75rem;
    width: 1.75rem;
  }

  .legacy-comment__meta {
    min-height: 1.75rem;
  }

  .legacy-comment__replies {
    margin-left: .85rem;
    padding-left: .7rem;
  }
}


/* Quality B: original photographs remain available; no script or image service. */
.post-body .photo-original { display: block; text-align: right; font-size: 13px; line-height: 1.6; }
.post-body .photo-original a { display: inline-flex; align-items: center; min-height: 44px; color: #285f58; }
.post-body img[data-responsive-photo] { height: auto; max-width: 100%; }
/* Quality C: native keyboard controls; no overlay on the code. */
.skip-link { position: absolute; left: 12px; top: 8px; z-index: 10000; padding: 10px 16px; min-height: 24px; color: #fff; background: #285f58; border: 2px solid #fff; border-radius: 4px; transform: translateY(-160%); }
.skip-link:focus { transform: none; outline: 3px solid #285f58; outline-offset: 2px; color: #fff; }
.code-copy-tools { display: flex; align-items: center; justify-content: flex-end; gap: 12px; margin: 12px 0 0; min-width: 0; }
.code-copy-tools button { flex: 0 0 auto; min-height: 44px; padding: 6px 12px; font: inherit; font-size: 14px; line-height: 1.5; color: #285f58; background: #f5f6f3; border: 1px solid #becbc5; border-radius: 4px; cursor: pointer; }
.code-copy-tools button:hover { background: #eaf1eb; }
.code-copy-tools button:focus-visible { outline: 2px solid #285f58; outline-offset: 3px; }
.code-copy-status { font-size: 13px; line-height: 1.5; overflow-wrap: anywhere; text-align: left; }
/* Quality D: paper-only presentation. Original page content and comments stay intact. */
.print-source { display: none; }
@media print {
  @page { margin: 16mm; }
  html, body { background: #fff !important; color: #111 !important; font-size: 11pt !important; }
  .header, .column, .sidebar, .sidebar-dimmer, .footer, .headband, .back-to-top, .reading-progress-bar, .sidebar-toggle, .toggle, .search-pop-overlay,
  .mobile-toc, .post-footer, .comments, .legacy-comments, .utterances, .post-translation, .post-meta-item-icon, .post-meta-item-text,
  .code-copy-tools, .skip-link, .photo-original, .sub-menu, .pagination, .forkme, .post-edit-link { display: none !important; }
  .main, .main-inner, .post-block, .post-content, .post-body { display: block !important; width: auto !important; max-width: none !important; min-height: 0 !important; margin: 0 !important; padding: 0 !important; border: 0 !important; box-shadow: none !important; opacity: 1 !important; transform: none !important; overflow: visible !important; }
  .post-header { margin: 0 0 6mm !important; text-align: left !important; }
  .post-title { font-size: 20pt !important; line-height: 1.35 !important; }
  .post-meta-container { margin: 2mm 0 !important; color: #444 !important; text-align: left !important; }
  .post-meta { margin: 0 !important; font-size: 9pt !important; }
  .print-source { display: block !important; margin: 2mm 0 5mm; font-size: 9pt; line-height: 1.5; overflow-wrap: anywhere; }
  .post-body { font-size: 11pt !important; line-height: 1.65 !important; text-align: left !important; }
  .post-body p { margin: 0 0 3.5mm; orphans: 3; widows: 3; }
  .post-body h2, .post-body h3, .post-body h4, .post-body h5, .post-body h6 { break-after: avoid; margin: 6mm 0 2.5mm; }
  .post-body h2 { font-size: 15pt; }
  .post-body h3 { font-size: 12.5pt; }
  .post-body h4, .post-body h5, .post-body h6 { font-size: 11pt; }
  .post-body a, .print-source a { color: #111 !important; text-decoration: underline; overflow-wrap: anywhere; }
  .post-body img { max-width: 100% !important; max-height: 220mm; width: auto; height: auto !important; object-fit: contain; break-inside: avoid; }
  .post-body figure:not(.highlight) { margin: 4mm 0; break-inside: avoid; }
  .post-body figure figcaption { color: #444 !important; font-size: 9pt !important; }
  .post-body blockquote { border-left: 2px solid #aaa; padding: 0 0 0 4mm; margin: 4mm 0; color: #333; }
  .post-body .table-container, .post-body .code-container, .post-body pre, .post-body figure.highlight { overflow: visible !important; max-height: none !important; height: auto !important; break-inside: auto; }
  .post-body table { table-layout: fixed; width: 100% !important; font-size: 9pt; }
  .post-body th, .post-body td { overflow-wrap: anywhere; word-break: normal; }
  .post-body figure.highlight, .post-body figure.highlight table, .post-body figure.highlight tbody, .post-body figure.highlight tr, .post-body figure.highlight td { display: block !important; width: auto !important; }
  .post-body figure.highlight .gutter { display: none !important; }
  .post-body pre, .post-body pre code, .post-body figure.highlight .line { white-space: pre-wrap !important; overflow-wrap: anywhere !important; word-break: break-word !important; }
  .post-body pre, .post-body code { font-size: 8.5pt !important; line-height: 1.5 !important; color: #111 !important; }
  .post-body figure.highlight pre { width: auto !important; padding: 3mm !important; }
  .post-body pre span { color: #111 !important; }
  .post-body iframe, .post-body video { max-width: 100%; }
}

/* Reading refresh: intentionally scoped away from legacy comments and media. */
.main-inner.post .post-description { display: none; }
.main-inner.index .post-block:not(:first-of-type) { margin-top: 64px; }
.main-inner.index .home-latest + .post-block { padding-top: 0; margin-top: 0; }
.home-guide { padding-top: 48px; }
.home-intro { color: #666; margin: 0 0 16px; }
.home-guide h2 { font-size: 20px; margin: 0 0 12px; }
.home-featured { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 24px; list-style: none; padding: 0; margin: 0 0 16px; }
.home-featured li { line-height: 1.6; font-size: 16px; min-width: 0; }
.home-featured a { display: block; }
.home-topics { display: flex; flex-wrap: wrap; gap: 4px 16px; }
.home-topics a { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; }
.home-latest { font-size: 18px; color: #666; margin: 24px 0; }
.post-translation a { display: inline-block; }
.home-guide a:focus-visible, .post-translation a:focus-visible, .post-body a:focus-visible { outline: 2px solid #287f78; outline-offset: 4px; }
@media (max-width: 767px) {
  .main-inner.index .post-block:not(:first-of-type) { margin-top: 48px; }
  .home-guide { padding-top: 28px; }
  .home-featured { grid-template-columns: 1fr; gap: 8px; }
  .home-intro { font-size: 15px; line-height: 1.6; }
}
/* Discovery: shared, text-first UI; does not restyle article prose or comments. */
.mobile-toc { display: none; }
.menu-item a[href$="/subscribe/"] { box-sizing: border-box; min-height: 44px; align-items: center; }
.post-body .subscription-card { padding: 20px; margin: 24px 0; background: #f8f7f3; border: 1px solid #d3d0c8; border-radius: 6px; text-align: left; }
.post-body .subscription-card h2 { margin: 0 0 8px; border: 0; font-size: 20px; }
.subscription-card p { margin: 8px 0; font-size: 15px; }
.subscription-address { display: flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; user-select: all; font-size: 16px; color: #285f58; }
.subscription-card button { box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 16px; padding: 8px 14px; max-width: 100%; font: inherit; font-size: 15px; line-height: 1.5; color: #fff; background: #28665f; border: 1px solid #28665f; border-radius: 5px; cursor: pointer; }
.subscription-card button[hidden] { display: none; }
.subscription-card button:focus-visible { outline: 2px solid #28665f; outline-offset: 3px; }
.subscription-card .subscription-status { min-height: 1.6em; margin-bottom: 0; color: #454545; }
.related-reading { margin-top: 40px; padding-top: 20px; border-top: 1px solid #dedbd4; text-align: left; }
.related-reading h2 { margin: 0 0 14px; font-size: 20px; }
.related-reading ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px 28px; }
.related-reading li { min-width: 0; }
.related-reading a { display: flex; align-items: center; box-sizing: border-box; min-height: 44px; padding: 6px 0; border: 0; color: #285f58; font-size: 17px; line-height: 1.55; overflow-wrap: anywhere; }
.related-reading a:hover { text-decoration: underline; }
.related-reading a:focus-visible { outline: 2px solid #28665f; outline-offset: 3px; }
.related-reading time { display: block; color: #555; font-size: 13px; }
.related-reading p { margin: 6px 0 0; font-size: 15px; line-height: 1.7; overflow-wrap: anywhere; }
@media (max-width: 767px) {
  .related-reading { padding-left: 32px; }
  .related-reading ul { grid-template-columns: minmax(0,1fr); }
  .post-body .subscription-card { padding-left: 28px; padding-right: 28px; }
  .mobile-toc { display: block; position: sticky; top: 8px; z-index: 9; margin: 0 0 24px; color: #343d3b; background: #f8f7f3; border: 1px solid #cfcec8; border-radius: 6px; font-size: 15px; line-height: 1.6; }
  .mobile-toc summary { box-sizing: border-box; min-height: 44px; padding: 10px 14px; cursor: pointer; overflow-wrap: anywhere; }
  .mobile-toc nav { max-height: 60vh; overflow-y: auto; overscroll-behavior: contain; border-top: 1px solid #dedbd4; }
  .mobile-toc ol { list-style: none; margin: 0; padding: 0 22px; }
  .mobile-toc ol ol { padding-right: 0; padding-left: 16px; }
  .mobile-toc a { box-sizing: border-box; display: flex; align-items: center; min-height: 44px; padding: 8px 4px; border: 0; color: #285f58; overflow-wrap: anywhere; text-align: left; }
  .mobile-toc summary:focus-visible, .mobile-toc a:focus-visible { outline: 2px solid #28665f; outline-offset: -3px; }
  .mobile-toc + .post-body h2, .mobile-toc + .post-body h3 { scroll-margin-top: 96px; }
  .mobile-toc[open] + .post-body h2, .mobile-toc[open] + .post-body h3 { scroll-margin-top: calc(60vh + 96px); }
}
.discovery-list { list-style: none; margin: 0; padding: 0; }
.post-body .discovery-list { margin: 0; padding: 0; }
.discovery-note { border-bottom: 1px solid #dedbd4; padding: 24px 0; margin: 0; }
.discovery-note[hidden], .discovery-filters[hidden] { display: none; }
.discovery-note h2, .discovery-year h2 { font-size: 20px; line-height: 1.55; margin: 8px 0; overflow-wrap: anywhere; }
.discovery-note h2 a, .discovery-year h2 a { display: block; padding: 4px 0; }
.discovery-note-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; color: #555; font-size: 13px; line-height: 1.6; margin: 0; }
.discovery-kind { color: #24605b; }
.discovery-description { color: #505050; font-size: 15px; line-height: 1.75; margin: 6px 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.discovery-filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 12px; }
.discovery-filters button { appearance: none; font: inherit; font-size: 14px; color: #454545; background: #fff; border: 1px solid #ccc8bf; border-radius: 6px; padding: 8px 14px; min-height: 44px; cursor: pointer; }
.discovery-filters button[aria-pressed=true] { color: #fff; background: #28665f; border-color: #28665f; }
.discovery-filters button:focus-visible, .discovery-series a:focus-visible { outline: 2px solid #28665f; outline-offset: 3px; }
.discovery-count { color: #555; font-size: 14px; margin: 12px 0; }
.discovery-year { display: grid; grid-template-columns: 64px minmax(0,1fr); gap: 16px; padding: 22px 0; border-bottom: 1px solid #dedbd4; }
.discovery-year-label { color: #28665f; font-size: 22px; padding-top: 10px; font-variant-numeric: tabular-nums; }
.discovery-back { text-align: center; font-size: 14px; margin: 24px 0; }
.discovery-back a { display: inline-block; padding: 10px 6px; }
.discovery-series { margin: 36px 0; padding: 20px; background: #f5f4f0; border: 1px solid #dedbd4; border-radius: 6px; }
.discovery-series-label { margin: 0 0 14px; font-size: 15px; text-align: center; }
.discovery-series-links { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.2fr) minmax(0,1fr); align-items: center; gap: 12px; text-align: center; }
.discovery-series-links a { display: flex; flex-direction: column; justify-content: center; min-height: 44px; padding: 8px 0; border-bottom: 0; font-size: 14px; overflow-wrap: anywhere; }
.discovery-series-links strong { font-size: 21px; }
@media (max-width: 767px) {
  .discovery-note h2, .discovery-year h2 { font-size: 18px; }
  .discovery-description { -webkit-line-clamp: 3; }
  .discovery-year { grid-template-columns: 48px minmax(0,1fr); gap: 12px; }
  .discovery-year-label { font-size: 19px; }
  .discovery-series { padding: 14px 10px; }
  .discovery-series-links { gap: 6px; }
}
