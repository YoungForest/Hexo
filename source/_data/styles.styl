.post-body .review-cover {
  margin: 1.25rem auto;
  text-align: center;
}

.post-body .review-cover img {
  display: block;
  width: 200px;
  max-width: 100%;
  height: auto;
  margin: 0 auto;
  padding: 0;
  border: 0;
}

.post-body figure.review-cover:not(.highlight) figcaption {
  max-width: 32rem;
  margin: .65rem auto 0 !important;
  color: #666;
  font-size: 12px;
  font-weight: normal;
  line-height: 1.65;
}

.index .post-body .review-cover img {
  width: 160px;
}

.editorial-illustration {
  margin: 1.75rem auto;
}

.editorial-illustration--hero {
  margin-top: .75rem;
}

.editorial-illustration img {
  aspect-ratio: 16 / 9;
  display: block;
  height: auto;
  max-width: 100%;
  width: 100%;
}

.post-hero img {
  aspect-ratio: 16 / 9;
  display: block;
  height: auto;
  max-width: 100%;
  width: 100%;
}

@media (max-width: 390px) {
  .editorial-illustration {
    margin: 1.25rem auto;
  }
}

.post-meta,
.post-description
  color: #666

.followme span
  color: #666

.post-body .legacy-comments {
  border-top: 1px solid #d8dee4;
  margin: 3rem 0 1.5rem;
  padding-top: 1.6rem;
  text-align: left;
}

.legacy-comments__header {
  align-items: center;
  display: flex;
  gap: .75rem;
  justify-content: space-between;
}

.legacy-comments__title {
  align-items: center;
  border: 0;
  display: flex;
  font-size: 1.3rem;
  gap: .55rem;
  margin: 0;
  padding: 0;
}

.legacy-comments__count {
  align-items: center;
  background: #eff2f5;
  border-radius: 999px;
  color: #57606a;
  display: inline-flex;
  font-size: .72em;
  font-weight: 600;
  height: 1.65rem;
  justify-content: center;
  min-width: 1.65rem;
  padding: 0 .45rem;
}

.legacy-comments__badge {
  background: #f6f8fa;
  border: 1px solid #d0d7de;
  border-radius: 999px;
  color: #57606a;
  flex: 0 0 auto;
  font-size: .72rem;
  font-weight: 600;
  letter-spacing: .02em;
  line-height: 1.8;
  padding: 0 .65rem;
}

.legacy-comments__note {
  color: #656d76;
  font-size: .86rem;
  line-height: 1.6;
  margin: .45rem 0 1.5rem;
}

.legacy-comments__list,
.legacy-comment__replies {
  list-style: none;
  margin: 0;
  padding: 0;
}

.legacy-comments__list > .legacy-comment-item {
  padding: 0 0 1.35rem;
}

.legacy-comments__list > .legacy-comment-item + .legacy-comment-item {
  border-top: 1px solid #eaeef2;
  padding-top: 1.35rem;
}

.legacy-comment {
  align-items: start;
  display: grid;
  gap: .75rem;
  grid-template-columns: 2rem minmax(0, 1fr);
  overflow-wrap: anywhere;
}

.legacy-comment__avatar {
  align-items: center;
  border: 1px solid rgba(31, 35, 40, .08);
  border-radius: 50%;
  display: inline-flex;
  font-size: .78rem;
  font-weight: 650;
  height: 2rem;
  justify-content: center;
  line-height: 1;
  text-transform: uppercase;
  width: 2rem;
}

.legacy-comment__avatar--0 { background: #e7f3f1; color: #1d746f; }
.legacy-comment__avatar--1 { background: #f6efe1; color: #8a6500; }
.legacy-comment__avatar--2 { background: #edf1f5; color: #57606a; }
.legacy-comment__avatar--3 { background: #f1edfa; color: #6f42c1; }
.legacy-comment__avatar--4 { background: #eaf2ff; color: #0969da; }
.legacy-comment__avatar--5 { background: #f8eeee; color: #b4232e; }

.legacy-comment__content {
  min-width: 0;
}

.legacy-comment__meta {
  align-items: baseline;
  display: flex;
  flex-wrap: wrap;
  gap: .25rem .65rem;
  justify-content: flex-start;
  min-height: 2rem;
  text-align: left;
}

.legacy-comment__author {
  border: 0;
  color: #24292f;
  font-size: .94rem;
  font-weight: 650;
  line-height: 1.5;
  margin: 0;
  padding: 0;
}

.legacy-comment__meta time {
  color: #6e7781;
  font-size: .76rem;
  white-space: nowrap;
}

.legacy-comment__body {
  color: #34383d;
  font-size: .94rem;
  line-height: 1.75;
  margin-top: .15rem;
  text-align: left;
}

.legacy-comment__replies {
  border-left: 1px solid #d8dee4;
  margin: 1rem 0 0 1rem;
  padding-left: 1rem;
}

.legacy-comment__replies > .legacy-comment-item + .legacy-comment-item {
  margin-top: 1rem;
}

@media (max-width: 390px) {
  .legacy-comments {
    margin-top: 2.25rem;
    padding-top: 1.25rem;
  }

  .legacy-comments__header {
    align-items: flex-start;
  }

  .legacy-comments__title {
    font-size: 1.18rem;
  }

  .legacy-comments__note {
    margin-bottom: 1.25rem;
  }

  .legacy-comment {
    gap: .6rem;
    grid-template-columns: 1.75rem minmax(0, 1fr);
  }

  .legacy-comment__avatar {
    font-size: .7rem;
    height: 1.75rem;
    width: 1.75rem;
  }

  .legacy-comment__meta {
    min-height: 1.75rem;
  }

  .legacy-comment__replies {
    margin-left: .85rem;
    padding-left: .7rem;
  }
}
