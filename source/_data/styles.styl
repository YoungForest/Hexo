.editorial-illustration {
  margin: 1.75rem auto;
}

.editorial-illustration--hero {
  margin-top: .75rem;
}

.editorial-illustration img {
  aspect-ratio: 16 / 9;
  display: block;
  height: auto;
  max-width: 100%;
  width: 100%;
}

.post-hero img {
  aspect-ratio: 16 / 9;
  display: block;
  height: auto;
  max-width: 100%;
  width: 100%;
}

@media (max-width: 390px) {
  .editorial-illustration {
    margin: 1.25rem auto;
  }
}

.post-meta,
.post-description
  color: #666

.followme span
  color: #666
