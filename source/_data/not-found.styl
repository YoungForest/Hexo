.not-found-intro { font-size: 18px; line-height: 1.8; }
.not-found-actions { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 24px 0; }
.not-found-actions a, .not-found-actions button { display: inline-flex; align-items: center; box-sizing: border-box; min-height: 44px; padding: 8px 12px; font: inherit; color: #285f58; border: 1px solid #becac4; border-radius: 4px; background: #f8faf9; }
.not-found-actions :focus-visible { outline: 2px solid #28665f; outline-offset: 2px; }
.not-found-languages { border-top: 1px solid #d6dcda; padding-top: 20px; margin-top: 28px; }
.not-found-languages a { display: inline-block; min-height: 44px; line-height: 44px; margin-right: 18px; }
